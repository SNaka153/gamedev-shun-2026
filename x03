rent 1px),linear-gradient(90deg,#d6d5de55 1px,transparent 1px);background-size:35px 35px;margin:0 18px;isolation:isolate}.stage:before{content:'';position:absolute;width:365px;height:365px;border:1px solid #c7c5d2;border-radius:50%;top:48px;left:50%;transform:translateX(-50%)}.stage:after{content:'';position:absolute;width:475px;height:475px;border:1px dashed #cfccd9;border-radius:50%;top:-7px;left:50%;transform:translateX(-50%);z-index:-1}.coordinate{position:absolute;font:9px var(--mono);letter-spacing:1px;color:#747181;z-index:1}.coordinate.top{left:12px;top:15px}.coordinate.bottom{right:12px;bottom:10px}.axis-label{position:absolute;left:15px;bottom:20px;font:10px var(--mono);color:#797488}.ship-visual{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(8px 20px 12px #30254826);transition:filter .4s}.ship-shell{transform-origin:320px 275px;transform:rotate(-26deg);transition:transform .65s ease}.blueprint .ship-shell{transform:rotate(0deg)}.blueprint{background-color:#e5e9f3}.blueprint .ship-visual{filter:drop-shadow(0 0 2px #31305210)}.blueprint .ship-hull{fill:#e9edf9;stroke:#5f7097;stroke-width:1.5}.engine-flame{transform-box:fill-box;transform-origin:top;animation:enginePulse 1.7s infinite alternate ease-in-out}.ship-ring{opacity:.5}.shield-halo{fill:none;stroke:var(--accent);stroke-width:1;stroke-dasharray:7 7;opacity:.35}.stage-tag{position:absolute;right:22px;top:44px;writing-mode:vertical-rl;font:10px var(--mono);letter-spacing:3px;color:#8b879a}.preview-bottom{padding:14px 25px 22px;display:flex;align-items:end;justify-content:space-between;border-top:1px solid #dad7e2}.ship-title{font-size:25px;font-weight:500;letter-spacing:-.9px;overflow-wrap:anywhere}.craft-type{font:10px var(--mono);letter-spacing:1px;color:var(--muted);margin-top:4px}.ready-badge{display:inline-flex;gap:6px;align-items:center;padding:5px 9px;background:#e5eee6;color:var(--good);font:10px var(--mono);border-radius:4px;white-space:nowrap}.ready-badge.warn{color:var(--bad);background:#f6e7e3}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:13px}.stat{padding:16px 18px;background:white;border:1px solid var(--line);border-radius:10px}.stat .eyebrow{font-size:9px;color:var(--muted)}.stat strong{font-size:27px;font-weight:400;display:inline-block;margin:5px 0 3px;letter-spacing:-1px}.stat .unit{font:11px var(--mono);color:var(--muted)}.track{height:4px;background:#e9e7ed;border-radius:5px;margin:7px 0;overflow:hidden}.track span{height:100%;display:block;background:var(--accent);transition:width .25s;border-radius:5px}.stat small{font-size:10px;color:var(--muted)}.status-strip{display:flex;gap:16px;align-items:center;margin-top:18px;padding:16px 19px;background:#e9e6f4;border:1px solid #d6d0e7;border-radius:10px}.status-mark{font-size:22px;color:var(--accent)}.status-copy{font-size:12px;flex:1}.status-copy strong{display:block;margin-bottom:3px}.status-copy p{font-size:11px;color:var(--muted)}.status-strip.warn{background:#fbefe6;border-color:#ead6c8}.status-strip.warn .status-mark{color:var(--bad)}.readout{padding:14px;border:1px solid var(--line);border-radius:8px;margin-bottom:16px;background:#f9f8fc}.readout-row{display:flex;justify-content:space-between;gap:16px;font-size:12px;padding:4px 0}.readout-row strong{font-family:var(--mono);font-weight:normal}.checks{padding:0;list-style:none;margin:12px 0 18px}.checks li{font-size:12px;padding:9px 0;border-bottom:1px solid #edecf1;display:flex;gap:8px}.checks .check-icon{color:var(--good);font-weight:bold}.checks .fail{color:var(--bad)}.agreement{display:flex;gap:10px;align-items:start;font-size:11px;line-height:1.6;margin-top:12px}.agreement input{accent-color:var(--accent);margin-top:3px}.error{color:var(--bad);font-size:12px;margin-top:12px}.export-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}.export-row .quiet{font-size:10px;flex:1}.json-details{margin-top:17px;font-size:11px}.json-details summary{cursor:pointer;color:var(--accent)}.json-details pre{font:10px/1.5 var(--mono);overflow:auto;max-height:160px;padding:12px;background:#f5f4f8;border-radius:6px}.footer{display:flex;justify-content:space-between;gap:24px;align-items:start;padding:25px 0 30px;margin-top:10px;font-size:10px;color:var(--muted)}.footer p{max-width:590px}.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;transition:.25s;background:#252334;color:#fff;box-shadow:0 8px 25px #14112433;padding:13px 20px;border-radius:10px;font-size:12px;z-index:40;max-width:90vw}.toast.show{opacity:1;transform:translate(-50%,0)}dialog{border:1px solid #dedbe9;border-radius:18px;padding:30px;width:min(600px,calc(100vw - 30px));background:#fbfaf8;color:var(--ink);box-shadow:0 20px 100px #08042044}dialog::backdrop{background:#19142880;backdrop-filter:blur(4px)}.dialog-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.dialog-top button{font-size:20px;border:1px solid var(--line);border-radius:50%;width:32px;height:32px}.launch-art{height:175px;background:#17192e;border-radius:12px;position:relative;overflow:hidden;margin:20px 0;background-image:radial-gradient(#9897cf 1px,transparent 1px);background-size:37px 43px}.launch-art:after{content:'';position:absolute;width:210px;height:210px;border:1px solid #555878;border-radius:50%;left:50%;top:24px;transform:translateX(-50%)}.launch-craft{position:absolute;left:calc(50% - 20px);top:64px;color:white;width:40px;z-index:2;animation:launchMove 2.4s ease-out both}.launch-summary{font-size:13px;line-height:1.8;margin:13px 0 20px}.dialog-actions{display:flex;gap:8px;flex-wrap:wrap}.notes-count{float:right}.how-it-works{font-size:12px;line-height:1.7}.how-it-works h3{margin:16px 0 5px}.how-it-works code{background:#edeaf7;padding:2px 4px;border-radius:3px;font-size:11px}.how-it-works p{margin-bottom:9px}
@keyframes enginePulse{from{transform:scaleY(.8);opacity:.7}to{transform:scaleY(1.12);opacity:.95}}@keyframes launchMove{0%{transform:translateY(60px);opacity:.2}70%{transform:translateY(-5px);opacity:1}100%{transform:translateY(-12px);opacity:1}}
@media(min-width:1450px){.main-grid{grid-template-columns:460px minmax(0,1fr)}.stage{height:475px}.panel{min-height:568px}}@media(max-width:1100px){.app{padding:0 24px}.main-grid{grid-template-columns:380px minmax(0,1fr)}.panel{padding:22px 19px}.stage{height:440px}.course{display:none}.hero-aside{display:none}.stat{padding:13px 11px}.ship-title{font-size:22px}}@media(max-width:800px){.app{padding:0 17px}.topbar{height:70px}.brand{font-size:16px;letter-spacing:2px}.logo{width:26px}.topnav{gap:14px}.main-grid{grid-template-columns:1fr}.visual-column{grid-row:1}.stage{height:325px}.ship-visual{height:110%;top:-7%}.stage:before{width:250px;height:250px;top:32px}.stage:after{width:320px;height:320px;top:0}.preview-head{padding:14px 18px}.preview-bottom{padding:12px 18px 16px}.hero{padding:24px 0}.hero p{font-size:13px}.toolbar{align-items:flex-start;flex-direction:column;gap:9px}.tool-actions{width:100%}.tool-actions button{flex:1}.save-state{font-size:11px}.panel{min-height:0;padding:24px}.config-foot{padding:16px 24px}.footer{flex-direction:column;gap:10px}.status-strip{margin-top:12px;margin-bottom:4px}.stage-tag{right:12px;top:30px}.coordinate.top{top:5px}.stats{gap:7px}.stat strong{font-size:22px}.stat small{font-size:9px}.hero h1{letter-spacing:-1.3px}.config{margin-top:3px}.topnav a{display:none}}
