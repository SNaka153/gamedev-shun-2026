<title>STARFORGE / X T1A03 Forms by Shunta</title>
<style>
/* 01 / VISUAL SYSTEM. No fonts, pictures, libraries or network requests. */
:root{--ink:#272638;--muted:#656576;--line:#dcdce4;--paper:#f5f4f0;--white:#fff;--accent:#6359c8;--tint:#eeecfa;--good:#246849;--bad:#a13d39;--radius:16px;--sans:Arial,Helvetica,sans-serif;--mono:'Courier New',monospace}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 var(--sans)}button,input,select,textarea{font:inherit}button,a,input,select,textarea{touch-action:manipulation}button{cursor:pointer}button:disabled{cursor:wait;opacity:.6}a{color:inherit;text-underline-offset:4px}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #8c7df1;outline-offset:4px}input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #c2bdf1;outline-offset:1px}button{border:0;background:none;color:inherit}h1,h2,h3,p{margin:0}h1{font-size:clamp(34px,3.4vw,53px);font-weight:500;line-height:1.12;letter-spacing:-2px}h2{font-size:23px;letter-spacing:-.65px;font-weight:500}h3{font-size:16px}.mono,.eyebrow{font:11px/1.5 var(--mono);letter-spacing:1.4px;text-transform:uppercase}.muted{color:var(--muted)}[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.app{max-width:1540px;margin:auto;padding:0 46px}.topbar{height:86px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:20px}.brand{display:flex;gap:12px;align-items:center;font-size:21px;font-weight:800;letter-spacing:3px}.logo{width:34px;height:34px}.course{padding:7px 11px;border:1px solid #d0cedd;border-radius:5px;margin-left:16px;font-size:10px;letter-spacing:.8px}.topnav{display:flex;gap:24px;align-items:center;font-size:12px}.hero{padding:32px 0 29px;display:flex;justify-content:space-between;gap:24px;align-items:end}.hero .eyebrow{color:var(--accent);margin-bottom:12px}.hero p{margin-top:12px;color:var(--muted);max-width:640px}.hero-aside{text-align:right;flex-shrink:0}.hero-aside strong{font-size:28px;font-weight:400;letter-spacing:-1px}.hero-aside span{display:block}.toolbar{border-top:1px solid var(--line);padding:14px 0;display:flex;gap:14px;align-items:center;justify-content:space-between}.tool-actions{display:flex;gap:8px;flex-wrap:wrap}.quiet{font-size:12px;padding:8px 12px;border:1px solid var(--line);border-radius:6px;background:#fafaf7}.quiet:hover{background:#eeedf6;border-color:#b4b0ce}.save-state{font-size:12px;color:var(--muted)}.save-state:before{content:'';display:inline-block;width:6px;height:6px;background:#918ac6;border-radius:100%;margin-right:8px}.main-grid{display:grid;grid-template-columns:420px minmax(0,1fr);gap:22px;align-items:start}.config{background:white;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}.steps{display:grid;grid-template-columns:1fr 1fr 1fr;border-bottom:1px solid var(--line);padding:0 16px}.step-button{font-size:12px;padding:19px 3px 16px;border-bottom:3px solid transparent;color:var(--muted);display:flex;align-items:center;gap:7px;justify-content:center}.step-button[aria-current=step]{color:var(--accent);border-bottom-color:var(--accent);font-weight:700}.step-number{font:11px var(--mono);border:1px solid #d4d2dd;border-radius:50%;width:22p