<dialog id="resetDialog" aria-labelledby="resetHeading"><div class="dialog-top"><h2 id="resetHeading">Start a fresh design?</h2></div><p>The current design and its saved draft on this browser will be reset. Export a JSON copy first if you want to keep it.</p><div class="dialog-actions" style="margin-top:22px"><button type="button" class="quiet" id="cancelReset">Keep designing</button><button type="button" class="primary" id="confirmReset">Reset design</button></div></dialog>
<dialog id="guideDialog" aria-labelledby="guideHeading"><div class="dialog-top"><h2 id="guideHeading">A form that builds something.</h2><button type="button" id="closeGuide" aria-label="Close explanation">×</button></div><div class="how-it-works"><p>Related assignment: <a href="t1a03-forms-shunta.html">T1A03 Forms by Shunta ↗</a></p><h3>01 · Inputs become one design</h3><p>Text, date, number, radio, checkbox, color, range, select and textarea controls feed a <code>FormData</code> object. An <code>input</code> event updates the SVG ship and statistics immediately.</p><h3>02 · Choices have consequences</h3><p>Battery adds range, power and cost. Engines consume power. A hull sets crew capacity. Each mission needs one module. The submit handler checks these relationships before launching.</p><h3>03 · Keep your design</h3><p>Save draft stores this design in this browser's <code>localStorage</code>. Export JSON makes a portable copy; import reads it back after checking its shape. Storage can be unavailable in private or restricted browsers. Files are a reliable alternative.</p><h3>04 · A tiny game model</h3><p>Range = hull range + battery × 0.7 − crew × 3 − modules × 4.<br>Power available = 40 + battery × 0.85.<br>Power draw = 22 + engine × 0.45 + crew × 5 + module power.<br>Cost = hull + battery × 15 + engine × 8 + crew × 70 + module costs.</p><p>These are invented balancing rules, not aerospace calculations. Try a low battery and high engine output to see validation in action.</p></div></dialog>
<script>
'use strict';
/* 02 / DATA. One table per kind of choice keeps rules separate from the UI. */
const myHulls = {
  scout:{name:'Pathfinder',code:'PF-02',crew:2,cost:1800,mass:1.6,range:55},
  hauler:{name:'Hauler',code:'HL-04',crew:4,cost:2400,mass:2.8,range:35},
  surveyor:{name:'Surveyor',code:'SV-03',crew:3,cost:2200,mass:2.2,range:45}
};
const myModules = {scanner:{name:'Surface scanner',cost:360,power:14},beacon:{name:'Relay antenna',cost:280,power:12},cargo:{name:'Cargo bay',cost:420,power:9},shield:{name:'Debris shield',cost:480,power:20}};
const myMissions = {survey:{name:'Lunar survey',range:70,budget:5000,module:'scanner'},relay:{name:'Deep-space relay',range:85,budget:5100,module:'beacon'},delivery:{name:'Habitat delivery',range:65,budget:5000,module:'cargo'}};
const myForm = document.getElementById('shipForm');
const myStorageKey = 'shunta.starforge.forms.v1';
let myStep = 0, myToastTimer, myLaunchedDesign = null;
const myGet = id => document.getElementById(id);
const myClamp = (n,min,max) => Math.min(max,Math.max(min,n));
const myEscape = value => String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c]));
const myTomorrow = () => {const d=new Date();d.setDate(d.getDate()+1);return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');};
myGet('launchDate').value = myTomorrow();

/* 03 / INPUT. FormData reads named controls. Checkboxes share a name. */
function myReadForm(){
  const myData = new FormData(myForm);
  return {callsign:String(myData.get('callsign')).trim(),hull:myData.get('hull'),mission:myData.get('mission'),crew:Number(myData.get('crew')),launchDate:myData.get('launchDate'),accent:myData.get('accent'),battery:Number(myData.get('battery')),thrust:Number(myData.get('thrust')),modules:myData.getAll('modules'),notes:String(myData.get('notes')).trim()};
}
/* 04 / MODEL. Pure calculations: the same data always gives the same answer. */
function myCalculate(myState){
  const h=myHulls[myState.hull], m=myMissions[myState.mission];
  const moduleCost=myState.modules.reduce((sum,key)=>sum+myModules[key].cost,0);
  const modulePower=myState.modules.reduce((sum,key)=>sum+myModules[key].power,0);
  const cost=h.cost+myState.battery*15+myState.thrust*8+myState.crew*70+moduleCost;
  const range=Math.round(h.range+myState.battery*.7-myState.crew*3-myState.modules.length*4);
  const speed=Math.round(myClamp(100-h.mass*12-myState.battery*.12+myState.thrust*.35-myState.modules.length*4,25,140));
  const supply=40+myState.battery*.85;
  const draw=22+myState.thrust*.45+myState.crew*5+modulePower;
  const checks=[
    {ok:Number.isInteger(myState.crew)&&myState.crew>=1&&myState.crew<=h.crew,text:myState.crew+' / '+h.crew+' crew seats',fix:'Choose 1–'+h.crew+' crew, or switch to a larger hull.'},
    {ok:cost<=m.budget,text:cost.toLocaleString()+' / '+m.budget.toLocaleString()+' credits',fix:'Lower engine output or battery, or remove optional modules to meet the budget.'},
    {ok:draw<=supply,text:draw.toFixed(1)+' / '+supply.toFixed(1)+' power',fix:'Increase battery or reduce engine output / optional modules to balance power.'},
    {ok:range>=m.range,text:range+' / '+m.range+' required range',fix:'Add battery, reduce crew/modules, or use a longer-range hull.'},
    {ok:myState.modules.includes(m.module),text:myModules[m.module].name+' fitted',fix:'Fit the '+myModules[m.module].name.toLowerCase()+' in Systems for this mission.'}
  ];
  return {cost,range,speed,supply,draw,checks,ready:checks.every(c=>c.ok)};
}
/* 05 / VISUAL. All spacecraft artwork below is original SVG geometry. */
function myShipDrawing(s){
  const a=myEscape(s.accent),wide=s.hull==='hauler',science=s.hull==='surveyor';
  const wing=wide?'M272 213 209 231 186 349 270 329Z':science?'M275 215 143 266 122 338 264 310Z':'M280 209 208 267 155 376 277 325Z';
  const mirrored=wide?'M368 213 431 231 454 349 370 329Z':science?'M365 215 497 266 518 338 376 310Z':'M360 209 432 267 485 376 363 325Z';
  let drawing=`<defs><linearGradient id="metal" x1="0" y1="0" x2="1" y2=".65"><stop offset="0" stop-color="#fcfcff"/><stop offset=".53" stop-color="#d7d8e0"/><stop offset="1" stop-color="#9d9eae"/></linearGradient><linearGradient id="side" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#999aaa"/><stop offset="1" stop-color="#55566a"/></linearGradient><linearGradient id="glass" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#4a5573"/><stop offset=".45" stop-color="#a7bfd0"/><stop offset="1" stop-color="#1e253c"/></linearGradient><linearGradient id="flame" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#c3efff"/><stop offset=".3" stop-color="${a}"/><stop offset="1" stop-color="${a}" stop-opacity="0"/></linearGradient></defs><g class="ship-shell">`;
  if(s.modules.includes('shield'))drawing+=`<ellipse class="shield-halo" cx="320" cy="259" rx="180" ry="214" fill="none" stroke="${a}" stroke-width="1" stroke-dasharray="7 7" opacity=".35"/>`;
  drawing+=`<g class="engine-flame" opacity=".85"><path d="M233 337 229 ${380+s.thrust*.65} 245 ${412+s.thrust*.6} 258 ${380+s.thrust*.65} 256 337Z" fill="url(#flame)"/><path d="M384 337 382 ${380+s.thrust*.65} 397 ${412+s.thrust*.6} 411 ${380+s.thrust*.65} 407 337Z" fill="url(#flame)"/></g><path d="${wing}" fill="url(#side)" stroke="#7d7e91"/><path d="${mirrored}" fill="url(#side)" stroke="#7d7e91"/><path class="ship-hull" d="M320 73 367 164 383 298 357 363 283 363 257 298 273 164Z" fill="url(#metal)" stroke="#aaaab7"/><path d="M320 73 320 352 355 347 372 294 358 164Z" fill="#c0c0ce" opacity=".6"/><path d="M320 78 331 173 320 192 309 173Z" fill="${a}"/><path d="M301 164 320 140 339 164 344 213 320 226 296 213Z" fill="#33394e" stroke="#9298aa" stroke-width="3"/><path d="M305 166 320 149 335 166 337 205 320 216 303 205Z" fill="url(#glass)"/><path d="M306 166 313 159 309 200 304 196Z" fill="#d1e6ef" opacity=".75"/><path d="M277 249 297 260 298 314 283 338 268 296Z" fill="${a}"/><path d="M363 249 343 260 342 314 357 338 372 296Z" fill="${a}"/><path d="M306 255H334V331H306Z" fill="#e6e6ec" stroke="#b4b3c1"/><path d="M312 266H328M312 277H328M312 288H328M312 299H328" stroke="#8f8d9f" stroke-width="3"/><path d="M273 237 286 229M367 237 354 229M288 352H352" stroke="#9b99aa" stroke-width="2"/><g fill="url(#metal)" stroke="#9e9baa"><rect x="225" y="262" width="37" height="82" rx="13"/><rect x="378" y="262" width="37" height="82" rx="13"/></g><g fill="${a}"><rect x="233" y="273" width="21" height="39" rx="3"/><rect x="386" y="273" width="21" height="39" rx="3"/></g><g stroke="#454255" stroke-width="4"><path d="M231 322H256M231 330H256M384 322H409M384 330H409"/></g><path d="M305 353 300 377H340L335 353Z" fill="#656373"/><path d="M315 357V372M325 357V372" stroke="#b9b4d4" stroke-width="3"/><g fill="#ffffff"><circle cx="244" cy="264" r="3"/><circle cx="396" cy="264" r="3"/></g>`;
  if(s.modules.includes('scanner'))drawing+=`<circle cx="320" cy="240" r="11" fill="#262943" stroke="#c8c5dd" stroke-width="3"/><circle cx="320" cy="240" r="5" fill="${a}"/>`;
  if(s.modules.includes('beacon'))drawing+=`<path d="M364 201 402 146M402 146V123" stroke="#57536e" stroke-width="3"/><circle cx="402" cy="143" r="5" fill="${a}"/><path d="M389 132Q402 122 415 132M384 124Q402 111 420 124" fill="none" stroke="${a}" stroke-width="2"/>`;
  if(s.modules.includes('cargo'))drawing+=`<g fill="#bbb8ca" stroke="#797589"><rect x="190" y="266" width="28" height="65" rx="3"/><rect x="422" y="266" width="28" height="65" rx="3"/><path d="M190 282H218M190 310H218M422 282H450M422 310H450"/></g>`;
  drawing+=`<text x="304" y="130" transform="rotate(-90 304 130)" font-family="Arial,sans-serif" font-size="6" fill="#6f6b80">STARFORGE</text><text x="316" y="323" font-family="monospace" font-size="8" fill="#716980">17</text></g>`;
  return drawing;
}
function mySetText(id,value){myGet(id).textContent=value;}
function myRender(){
  const s=myReadForm(),h=myHulls[s.hull],m=myMissions[s.mission],v=myCalculate(s);
  myGet('crew').max=h.crew;
  myGet('callsign').setCustomValidity(s.callsign.length<2?'Enter a spacecraft name with at least 2 non-space characters.':'');
  myGet('crew').setCustomValidity(Number.isInteger(s.crew)&&s.crew>=1&&s.crew<=h.crew?'':'Choose 1–'+h.crew+' crew for this hull.');
  mySetText('crewHelp','This hull seats up to '+h.crew+'.');
  mySetText('missionHelp','Requires '+m.range+' range + '+myModules[m.module].name.toLowerCase()+'. Budget '+m.budget.toLocaleString()+' cr.');
  mySetText('batteryValue',s.battery+'%');mySetText('thrustValue',s.thrust+'%');
  myGet('shipSvg').innerHTML=myShipDrawing(s);
  myGet('shipSvg').setAttribute('aria-label',h.name+' spacecraft with '+(s.modules.map(k=>myModules[k].name).join(', ')||'no modules'));
  mySetText('previewName',s.callsign||'UNTITLED');mySetText('previewType',h.name.toUpperCase()+' / '+m.name.toUpperCase());mySetText('hullCode',h.code);
  for(const [id,val,max] of [['range',v.range,130],['speed',v.speed,140],['cost',v.cost,m.budget]]){mySetText(id+'Stat',val.toLocaleString());myGet(id+'Bar').style.width=myClamp(val/max*100,0,100)+'%';}
  myGet('costBar').style.background=v.cost>m.budget?'var(--bad)':'var(--accent)';
  mySetText('rangeHint','Mission minimum '+m.range+' u');mySetText('speedHint','Fictional cruise rating');mySetText('costHint',v.cost<=m.budget?(m.budget-v.cost).toLocaleString()+' cr remaining':(v.cost-m.budget).toLocaleString()+' cr over budget');
  mySetText('powerDetail',v.draw.toFixed(1)+' / '+v.supply.toFixed(1));mySetText('budgetDetail',v.cost.toLocaleString()+' / '+m.budget.toLocaleString()+' cr');
  const failures=v.checks.filter(c=>!c.ok);
  myGet('readyBadge').classList.toggle('warn',!v.ready);mySetText('readyBadge',v.ready?'● Systems ready':'○ Check systems');
  myGet('statusStrip').classList.toggle('warn',!v.ready);mySetText('statusTitle',v.ready?'A balanced design. Your mission is within reach.':failures.length+' flight check'+(failures.length>1?'s':'')+' need attention.');mySetText('statusText',v.ready?'Visit Flight check to review the inputs and issue your manifest.':failures[0].fix);
  myGet('reviewSummary').innerHTML='';
  for(const [label,value] of [['Callsign',s.callsign||'Missing name'],['Mission',m.name],['Launch',s.launchDate||'Choose a date']]){const row=document.createElement('div');row.className='readout-row';const key=document.createElement('span');key.textContent=label;const val=document.createElement('strong');val.textContent=value;row.append(key,val);myGet('reviewSummary').append(row);}
  myGet('checkList').innerHTML='';
  v.checks.forEach(c=>{const li=document.createElement('li'),icon=document.createElement('span'),copy=document.createElement('span');icon.className='check-icon'+(c.ok?'':' fail');icon.textContent=c.ok?'✓':'!';copy.textContent=c.text+(c.ok?'':' — needs attention');li.append(icon,copy);myGet('checkList').append(li);});
  mySetText('notesCount',myGet('notes').value.length+' / 180');mySetText('dataView',JSON.stringify(s,null,2));
  document.querySelectorAll('[data-color]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.color===s.accent.toLowerCase())));
}
/* 06 / NAVIGATION + VALIDATION. Hidden panels are revealed before focus. */
function myShowStep(index,focus=false){
  myStep=myClamp(index,0,2);
  for(let i=0;i<3;i++)myGet('panel'+i).hidden=i!==myStep;
  document.querySelectorAll('[data-step]').forEach(b=>{if(Number(b.dataset.step)===myStep)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current');});
  myGet('backBtn').hidden=myStep===0;myGet('stepLabel').hidden=myStep!==0;myGet('nextBtn').hidden=myStep===2;myGet('launchBtn').hidden=myStep!==2;
  myGet('nextBtn').innerHTML=(myStep===0?'Configure systems':'Review flight')+' <span>→</span>';
  if(focus)myGet(['identityHeading','systemsHeading','reviewHeading'][myStep]).focus({preventScroll:true});
}
function myCheckInputs(scope=myForm,includeConfirm=true){
  myRender();
  const inputs=[...scope.querySelectorAll('input,select,textarea')].filter(e=>includeConfirm||e.id!=='confirm');
  for(const input of inputs){if(!input.checkValidity()){const panel=input.closest('.panel');if(panel)myShowStep(Number(panel.id.slice(-1)));input.reportValidity();input.focus();return false;}}
  return true;
}
function myNotice(message){mySetText('toast',message);myGet('toast').classList.add('show');clearTimeout(myToastTimer);myToastTimer=setTimeout(()=>myGet('toast').classList.remove('show'),4200);}
function myChanged(){myRender();myGet('formError').hidden=true;myGet('confirm').checked=false;mySetText('saveState','Unsaved changes · save a draft to keep them');}
myForm.addEventListener('input',e=>{if(e.target.id==='confirm'){myGet('formError').hidden=true;return;}myChanged();});
myForm.addEventListener('change',e=>{if(e.target.id!=='confirm'&&e.target.id!=='importFile')myChanged();});
document.querySelectorAll('[data-step]').forEach(b=>b.addEventListener('click',()=>myShowStep(Number(b.dataset.step))));
myGet('nextBtn').addEventListener('click',()=>{if(myCheckInputs(myGet('panel'+myStep),false))myShowStep(myStep+1,true);});
myGet('backBtn').addEventListener('click',()=>myShowStep(myStep-1,true));
myGet('reviewBtn').addEventListener('click',()=>{myShowStep(2,true);myGet('shipForm').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});});
document.querySelectorAll('[data-color]').forEach(b=>b.addEventListener('click',()=>{myGet('accent').value=b.dataset.color;myChanged();}));
function myView(blueprint){myGet('stage').classList.toggle('blueprint',blueprint);myGet('studioBtn').setAttribute('aria-pressed',String(!blueprint));myGet('blueprintBtn').setAttribute('aria-pressed',String(blueprint));}
myGet('studioBtn').addEventListener('click',()=>myView(false));myGet('blueprintBtn').addEventListener('click',()=>myView(true));
/* 07 / PORTABLE STATE. Import only recognized keys; never evaluate a file. */
function myPackage(state){return {app:'STARFORGE',version:1,assignment:'X / T1A03 Forms by Shunta',design:state};}
function myValidatePackage(data){
  if(!data||data.app!=='STARFORGE'||data.version!==1||!data.design)throw new Error('Choose a STARFORGE version 1 design file.');
  const s=data.design;
  if(typeof s.callsign!=='string'||s.callsign.trim().length<2||s.callsign.length>22||typeof s.hull!=='string'||typeof s.mission!=='string'||!Object.hasOwn(myHulls,s.hull)||!Object.hasOwn(myMissions,s.mission))throw new Error('The callsign, hull or mission is invalid.');
  for(const [key,min,max] of [['crew',1,4],['battery',20,100],['thrust',20,100]])if(!Number.isInteger(s[key])||s[key]<min||s[key]>max||(key!=='crew'&&s[key]%5!==0))throw new Error('The '+key+' value is outside its allowed range.');
  if(typeof s.accent!=='string'||!/^#[a-fA-F0-9]{6}$/.test(s.accent)||typeof s.notes!=='string'||s.notes.length>180)throw new Error('The color or notes are invalid.');
  if(typeof s.launchDate!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(s.launchDate)||s.launchDate.startsWith('0000'))throw new Error('Choose a valid launch date.');
  const date=new Date(s.launchDate+'T00:00:00Z');if(!Number.isFinite(date.getTime())||date.toISOString().slice(0,10)!==s.launchDate)throw new Error('The launch date is not a calendar date.');
  if(!Array.isArray(s.modules)||s.modules.length>4||new Set(s.modules).size!==s.modules.length||s.modules.some(k=>typeof k!=='string'||!Object.hasOwn(myModules,k)))throw new Error('The module list is invalid.');
  return {callsign:s.callsign.trim(),hull:s.hull,mission:s.mission,crew:s.crew,launchDate:s.launchDate,accent:s.accent,battery:s.battery,thrust:s.thrust,modules:[...s.modules],notes:s.notes};
}
function myApply(s){
  myForm.reset();
  for(const id of ['callsign','mission','crew','launchDate','accent','battery','thrust','notes'])myGet(id).value=s[id];
  document.querySelectorAll('[name=hull]').forEach(el=>el.checked=el.value===s.hull);
  document.querySelectorAll('[name=modules]').forEach(el=>el.checked=s.modules.includes(el.value));
  myGet('confirm').checked=false;myGet('formError').hidden=true;myRender();
}
myGet('saveBtn').addEventListener('click',()=>{
  if(!myCheckInputs(myForm,false))return;
  try{localStorage.setItem(myStorageKey,JSON.stringify(myPackage(myReadForm())));mySetText('saveState','Draft saved on this browser');myNotice('Draft saved. It will return when you reopen this page.');}
  catch{mySetText('saveState','Browser storage unavailable · use Export design');myNotice('Storage is unavailable. Export a JSON file to keep your design.');}
});
myGet('exampleBtn').addEventListener('click',()=>{myApply({callsign:'KEPLER-09',hull:'surveyor',mission:'relay',crew:2,launchDate:myTomorrow(),accent:'#217d83',battery:80,thrust:45,modules:['scanner','beacon'],notes:'Connect two remote research stations.'});myShowStep(1,true);mySetText('saveState','Example loaded · not saved');myNotice('Relay example loaded. Both antenna and scanner are fitted.');});
function myDownload(text,mime,filename){const url=URL.createObjectURL(new Blob([text],{type:mime}));const a=document.createElement('a');a.href=url;a.download=filename;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}
function myExport(state=myReadForm()){myDownload(JSON.stringify(myPackage(state),null,2),'application/json','starforge-design.json');myNotice('Design export created. Import this file to restore it.');}
myGet('exportBtn').addEventListener('click',()=>{if(myCheckInputs(myForm,false))myExport();});
myGet('importBtn').addEventListener('click',()=>myGet('importFile').click());
myGet('importFile').addEventListener('change',async e=>{
  const file=e.target.files[0];if(!file)return;
  try{if(file.size>30000)throw new Error('Design files must be smaller than 30 KB.');const state=myValidatePackage(JSON.parse(await file.text()));myApply(state);myShowStep(2,true);mySetText('saveState','Imported design · not saved');myNotice('Design imported. Review its checks before launching.');}
  catch(error){myNotice('Could not import. '+(error instanceof SyntaxError?'This file is not valid JSON.':error.message));}
  finally{myGet('importFile').value='';}
});
myGet('resetBtn').addEventListener('click',()=>myGet('resetDialog').showModal());
myGet('cancelReset').addEventListener('click',()=>myGet('resetDialog').close());
myGet('confirmReset').addEventListener('click',()=>{myForm.reset();myGet('launchDate').value=myTomorrow();myGet('callsign').setCustomValidity('');myGet('crew').setCustomValidity('');myGet('formError').hidden=true;let removed=true;try{localStorage.removeItem(myStorageKey);}catch{removed=false;}myShowStep(0);myView(false);myRender();mySetText('saveState',removed?'Fresh design · no saved draft':'Fresh design · saved draft could not be removed');myGet('resetDialog').close();myNotice(removed?'Design reset. Your exported files are unchanged.':'Design reset. Browser storage was unavailable.');});
/* 08 / SUBMIT. Validate native fields and cross-field rules, then render a result. */
myForm.addEventListener('submit',e=>{
  e.preventDefault();
  if(myStep!==2){if(myCheckInputs(myGet('panel'+myStep),false))myShowStep(myStep+1,true);return;}
  if(!myCheckInputs())return;
  const s=myReadForm(),v=myCalculate(s);
  if(!v.ready){myGet('formError').hidden=false;mySetText('formError',v.checks.find(c=>!c.ok).fix);myNotice('Resolve the flight checks before launch.');return;}
  myLaunchedDesign=JSON.parse(JSON.stringify(s));
  mySetText('launchHeading',s.callsign+' is cleared for exploration.');
  mySetText('launchSummary',myMissions[s.mission].name+' · '+myHulls[s.hull].name+' · '+s.crew+' crew · '+s.launchDate+'. Estimated range '+v.range+' u. Build cost '+v.cost.toLocaleString()+' credits.');
  myGet('launchDialog').showModal();
});
myGet('closeLaunch').addEventListener('click',()=>myGet('launchDialog').close());
myGet('downloadManifest').addEventListener('click',()=>{if(myLaunchedDesign)myExport(myLaunchedDesign);});
myGet('downloadCard').addEventListener('click',()=>{
  if(!myLaunchedDesign)return;
  const s=myLaunchedDesign,v=myCalculate(s),h=myHulls[s.hull],m=myMissions[s.mission];
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="800" viewBox="0 0 1200 800"><rect width="1200" height="800" fill="#f4f3ef"/><rect x="30" y="30" width="1140" height="740" rx="20" fill="#eeedf2" stroke="#cfccd9"/><text x="70" y="90" fill="#262338" font-family="Arial,sans-serif" font-size="27" font-weight="bold" letter-spacing="5">STARFORGE</text><text x="70" y="128" fill="#6c6480" font-family="monospace" font-size="13">FLIGHT MANIFEST / BY SHUNTA / X T1A03 FORMS</text><circle cx="880" cy="395" r="227" fill="none" stroke="#d1cdda"/><svg x="560" y="118" width="610" height="580" viewBox="0 0 640 540">${myShipDrawing(s)}</svg><text x="70" y="248" fill="#292538" font-family="Arial,sans-serif" font-size="37">${myEscape(s.callsign)}</text><text x="70" y="288" fill="#6c6480" font-family="Arial,sans-serif" font-size="19">${myEscape(h.name+' / '+m.name)}</text><path d="M70 321H510" stroke="#d0ccd9"/><g font-family="monospace" font-size="19" fill="#3c374d"><text x="70" y="375">CREW       ${s.crew}</text><text x="70" y="415">RANGE      ${v.range} u</text><text x="70" y="455">SPEED      ${v.speed} u/s</text><text x="70" y="495">COST       ${v.cost} cr</text><text x="70" y="535">DEPARTURE  ${myEscape(s.launchDate)}</text></g><rect x="70" y="585" width="253" height="41" rx="5" fill="#e1eadf"/><text x="87" y="612" fill="#276249" font-family="monospace" font-size="15">ALL FLIGHT CHECKS PASSED</text><text x="70" y="726" fill="#6c6480" font-family="Arial,sans-serif" font-size="13">Fictional design simulation. Created entirely from form inputs.</text></svg>`;
  myDownload(svg,'image/svg+xml','starforge-flight-card.svg');myNotice('Flight card downloaded. Open it in a browser or print it.');
});
myGet('openGuide').addEventListener('click',()=>myGet('guideDialog').showModal());myGet('closeGuide').addEventListener('click',()=>myGet('guideDialog').close());
/* 09 / STARTUP. Restore a valid local draft, without trusting unknown file data. */
try{const saved=localStorage.getItem(myStorageKey);if(saved){myApply(myValidatePackage(JSON.parse(saved)));mySetText('saveState','Saved draft restored from this browser');}}catch{mySetText('saveState','No usable draft · export a file to keep your work');}
myRender();
</script>
</body>
</html>

